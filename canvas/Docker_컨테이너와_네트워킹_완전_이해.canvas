{
  "nodes": [
    {
      "id": "note",
      "type": "file",
      "file": "notes/Docker_컨테이너와_네트워킹_완전_이해.md",
      "x": -740,
      "y": 0,
      "width": 520,
      "height": 640
    },
    {
      "id": "container",
      "type": "text",
      "text": "컨테이너 = 격리된 작은 컴퓨터 (host와 단절)",
      "x": 600,
      "y": 0,
      "width": 460,
      "height": 160,
      "color": "6"
    },
    {
      "id": "three-holes",
      "type": "text",
      "text": "벽을 뚫는 3장치: port / volume / network",
      "x": 600,
      "y": 220,
      "width": 460,
      "height": 160,
      "color": "6"
    },
    {
      "id": "netns",
      "type": "text",
      "text": "network namespace = 격리의 정체 (NIC·라우팅·iptables 독립)",
      "x": 600,
      "y": 440,
      "width": 460,
      "height": 160,
      "color": "6"
    },
    {
      "id": "veth-bridge",
      "type": "text",
      "text": "veth pair + bridge = 컨테이너끼리 잇는 L2 스위치",
      "x": 600,
      "y": 660,
      "width": 460,
      "height": 160,
      "color": "6"
    },
    {
      "id": "embedded-dns",
      "type": "text",
      "text": "embedded DNS 127.0.0.11 = 서비스 이름 → IP (user-defined만)",
      "x": 600,
      "y": 880,
      "width": 460,
      "height": 160,
      "color": "6"
    },
    {
      "id": "host-internal",
      "type": "text",
      "text": "host.docker.internal:host-gateway = 컨테이너→진짜 맥 호스트",
      "x": 600,
      "y": 1100,
      "width": 460,
      "height": 160,
      "color": "6"
    },
    {
      "id": "nginx-upstream",
      "type": "text",
      "text": "예: nginx upstream을 host.docker.internal:PORT로 → 컨테이너든 yarn dev든 동일 도달",
      "x": 1200,
      "y": 0,
      "width": 460,
      "height": 160,
      "color": "3"
    },
    {
      "id": "s1",
      "type": "text",
      "text": "1. 외부 → macOS:80 (com.docker.backend가 bind)",
      "x": 0,
      "y": 0,
      "width": 460,
      "height": 160,
      "color": "4"
    },
    {
      "id": "s2",
      "type": "text",
      "text": "2. Docker Desktop이 LinuxKit VM으로 forward",
      "x": 0,
      "y": 220,
      "width": 460,
      "height": 160,
      "color": "4"
    },
    {
      "id": "s3",
      "type": "text",
      "text": "3. VM iptables PREROUTING DNAT → nginx 컨테이너 IP:80 (L3/L4)",
      "x": 0,
      "y": 440,
      "width": 460,
      "height": 160,
      "color": "4"
    },
    {
      "id": "s4",
      "type": "text",
      "text": "4. bridge + veth로 nginx eth0 도착 (L2 전송)",
      "x": 0,
      "y": 660,
      "width": 460,
      "height": 160,
      "color": "4"
    },
    {
      "id": "s5",
      "type": "text",
      "text": "5. nginx HTTP 파싱 → location 매칭 → proxy_pass (L7 라우팅)",
      "x": 0,
      "y": 880,
      "width": 460,
      "height": 160,
      "color": "4"
    },
    {
      "id": "s6",
      "type": "text",
      "text": "6. 헤어핀: 맥:3001로 나갔다가 컨테이너 또는 yarn dev로 수신",
      "x": 0,
      "y": 1100,
      "width": 460,
      "height": 160,
      "color": "4"
    }
  ],
