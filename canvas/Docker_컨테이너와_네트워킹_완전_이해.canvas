{
  "nodes": [
    {
      "id": "note",
      "type": "file",
      "file": "notes/Docker_컨테이너와_네트워킹_완전_이해.md",
      "x": -740,
      "y": 0,
      "width": 520,
      "height": 640
    },
    {
      "id": "container",
      "type": "text",
      "text": "컨테이너 = 격리된 작은 컴퓨터 (host와 단절)",
      "x": 600,
      "y": 0,
      "width": 460,
      "height": 160,
      "color": "6"
    },
    {
      "id": "three",
      "type": "text",
      "text": "벽을 뚫는 3장치: port / volume / network",
      "x": 600,
      "y": 220,
      "width": 460,
      "height": 160,
      "color": "6"
    },
    {
      "id": "netns",
      "type": "text",
      "text": "network namespace = 격리의 정체 (자기만의 NIC·라우팅·iptables)",
      "x": 600,
      "y": 440,
      "width": 460,
      "height": 160,
      "color": "6"
    },
    {
      "id": "veth",
      "type": "text",
      "text": "veth pair = namespace끼리 잇는 가상 랜선",
      "x": 600,
      "y": 660,
      "width": 460,
      "height": 160,
      "color": "6"
    },
    {
      "id": "bridge",
      "type": "text",
      "text": "bridge = veth들을 묶는 L2 소프트웨어 스위치 (172.18.0.1)",
      "x": 600,
      "y": 880,
      "width": 460,
      "height": 160,
      "color": "6"
    },
    {
      "id": "dns",
      "type": "text",
      "text": "embedded DNS 127.0.0.11 = 서비스 이름 → IP (user-defined만)",
      "x": 600,
      "y": 1100,
      "width": 460,
      "height": 160,
      "color": "6"
    },
    {
      "id": "hostgw",
      "type": "text",
      "text": "host.docker.internal:host-gateway = 컨테이너→진짜 맥 호스트",
      "x": 600,
      "y": 1320,
      "width": 460,
      "height": 160,
      "color": "6"
    },
    {
      "id": "s1",
      "type": "text",
      "text": "1. 외부 클라이언트 → macOS:80",
      "x": 0,
      "y": 0,
      "width": 460,
      "height": 160,
      "color": "4"
    },
    {
      "id": "s2",
      "type": "text",
      "text": "2. com.docker.backend가 :80 bind() 수신 → LinuxKit VM으로 forward",
      "x": 0,
      "y": 220,
      "width": 460,
      "height": 160,
      "color": "4"
    },
    {
      "id": "s3",
      "type": "text",
      "text": "3. VM iptables PREROUTING DNAT → nginx 컨테이너 IP:80 (L3/L4)",
      "x": 0,
      "y": 440,
      "width": 460,
      "height": 160,
      "color": "4"
    },
    {
      "id": "s4",
      "type": "text",
      "text": "4. bridge → veth → nginx eth0 (L2 전송)",
      "x": 0,
      "y": 660,
      "width": 460,
      "height": 160,
      "color": "4"
    },
    {
      "id": "s5",
      "type": "text",
      "text": "5. nginx가 HTTP 파싱, location /activity 매칭 (L7 라우팅 시작)",
      "x": 0,
      "y": 880,
      "width": 460,
      "height": 160,
      "color": "4"
    },
    {
      "id": "s6",
      "type": "text",
      "text": "6. upstream host.docker.internal:3001 → 맥 호스트로 헤어핀",
      "x": 0,
      "y": 1100,
      "width": 460,
      "height": 160,
      "color": "4"
    },
    {
      "id": "s7",
      "type": "text",
      "text": "7. 컨테이너(:3001 published) 또는 yarn dev Node 프로세스가 수신",
      "x": 0,
      "y": 1320,
      "width": 460,
      "height": 160,
      "color": "4"
    },
    {
      "id": "ex_hairpin",
      "type": "text",
      "text": "예: container든 yarn dev든 '맥:3000 도달'은 동일 — nginx는 구분 안 함",
      "x": 1200,
      "y": 0,
      "width": 460,
      "height": 160,
      "color": "3"
    },
    {
      "id": "ex_conntrack",
      "type": "text",
      "text": "예: conntrack = 커널 해시테이블에 5-tuple 기록 → 응답 자동 역NAT",
      "x": 1200,
      "y": 220,
      "width": 460,
      "height": 160,
      "color": "3"
    }
  ],
