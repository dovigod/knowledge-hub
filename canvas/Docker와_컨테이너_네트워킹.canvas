      "y": 0,
      "width": 460,
      "height": 160,
      "color": "3"
    },
    {
      "id": "s1",
      "type": "text",
      "text": "1. app.listen(3000) → bind() 시스템 콜",
      "x": 0,
      "y": 0,
      "width": 460,
      "height": 160,
      "color": "4"
    },
    {
      "id": "s2",
      "type": "text",
