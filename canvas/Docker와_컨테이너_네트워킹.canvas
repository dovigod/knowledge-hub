      "y": 220,
      "width": 460,
      "height": 160,
      "color": "4"
    },
    {
      "id": "s3",
      "type": "text",
      "text": "3. veth pair + docker0 bridge로 호스트 연결",
      "x": 0,
      "y": 440,
      "width": 460,
      "height": 160,
      "color": "4"
    },
    {
      "id": "s4",
      "type": "text",
      "text": "4. iptables DNAT: 호스트:8080 → 컨테이너IP:3000",
